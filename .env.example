# PAKT — copy to .env and fill in. Nothing here has a safe default for production.

# ---- required before real money ----
# Comma-separated operator emails. The ONLY way to get is_admin — it can never
# be set from a request body. With none set, the dispute SLA sweep does nothing
# at all, because escalating to an empty room is theatre.
PAKT_ADMIN_EMAILS=you@example.com

# ---- where the database lives ----
# MUST be on a persistent disk. On a host with an ephemeral filesystem this
# file — every user, deal and ledger row — is erased on every restart.
PAKT_DB=/var/lib/pakt/pakt.db

# ---- network ----
PORT=4000
# Bind to loopback when Caddy/nginx is in front, so the origin cannot be
# reached directly and X-Forwarded-For cannot be spoofed past the proxy.
PAKT_HOST=127.0.0.1

# Number of reverse proxies in front of this process. 0 = nothing in front.
# Behind one Caddy/nginx this is 1. If it stays 0 behind a proxy, every
# visitor on earth shares a single rate-limit bucket.
PAKT_TRUST_PROXY=1

# ---- rate limits (requests per minute per IP) ----
PAKT_RATE_LIMIT=120        # global ceiling
PAKT_RATE_LIMIT_AUTH=10    # /api/login and /api/signup
PAKT_RATE_LIMIT_MONEY=30   # fund / verify / cancel / resolve / to-deal
PAKT_RATE_LIMIT_WRITE=60   # every other mutating request

# ---- CORS ----
# Empty means same-origin only, which is correct while the app is served by
# this same process. Set a comma-separated origin list only if the frontend
# moves to its own host. Never set this to *.
PAKT_CORS_ORIGINS=

# ---- Instagram import (optional, for tools/import-creators.js) ----
# IG_USER_ID is YOUR Instagram Business account id — not your @handle and not
# your Facebook Page id. Token needs instagram_basic + instagram_manage_insights.
IG_USER_ID=
IG_ACCESS_TOKEN=
